---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { links } from '../data/site';

const credentials = [
  { label: 'Current', title: 'PhD, Mechanical Engineering', detail: 'University of Washington, AI Institute in Dynamic Systems' },
  { label: 'Education', title: 'MEng and BA', detail: 'Information and Computer Engineering, University of Cambridge' },
  { label: 'Industry research', title: 'Quantitative Research Intern', detail: 'J.P. Morgan, Quantitative Solutions' },
  { label: 'Research internship', title: 'Deep Learning Intern', detail: 'European Bioinformatics Institute' },
  { label: 'Publication', title: 'Journal article, 2025', detail: 'JGR: Machine Learning and Computation' },
  { label: 'Recognition', title: '2nd Place', detail: 'Citadel European Datathon, 2023' }
];

const experiences = [
  {
    dates: '2025 to present',
    role: 'Graduate Research Assistant',
    org: 'University of Washington, SCiDaMa Group',
    copy: 'Develop neural surrogates and reinforcement learning methods for high-dimensional flow control. Audit learned action sensitivities and validate controllers in direct numerical simulation.'
  },
  {
    dates: '2023 to 2025',
    role: 'Machine Learning Researcher',
    org: 'University of Cambridge',
    copy: 'Studied nonlocal state inference in neural PDE surrogates from partial and spatially coarsened observations.'
  },
  {
    dates: '2023 to 2025',
    role: 'Deep Learning Researcher',
    org: 'Imperial College London, Data Science Institute',
    copy: 'Compared CNN and transformer architectures for wildfire segmentation and analyzed feature attribution with SHAP, Grad-CAM, and Integrated Gradients.'
  },
  {
    dates: 'Summer 2024',
    role: 'Quantitative Research Intern',
    org: 'J.P. Morgan, Quantitative Solutions',
    copy: 'Built transformer research pipelines for financial-news sentiment analysis and stock-return forecasting.'
  },
  {
    dates: 'Summer 2023',
    role: 'Deep Learning Intern',
    org: 'European Bioinformatics Institute, Goldman Group',
    copy: 'Developed synthetic-data simulations and CNN and transformer models for biological sequence classification.'
  }
];

const awards = [
  { year: '2024', result: '1st Place', name: 'AIGC Hackbridge UK Hackathon' },
  { year: '2023', result: '2nd Place', name: 'Citadel European Datathon' },
  { year: '2023', result: 'Gold Medal', name: 'iGEM Synthetic Biology Competition' },
  { year: '2023', result: '1st Place', name: 'AIGC Hackbridge UK Hackathon' },
  { year: '2023', result: 'Top 1%', name: 'IMC Quantitative Trading Competition' }
];
---

<BaseLayout title="Ruige Kong" description="Ruige Kong is a PhD researcher at the University of Washington working on scientific machine learning, dynamical systems, fluid mechanics, and control.">
  <section class="hero shell" id="top">
    <div class="hero-photo-wrap reveal">
      <img class="hero-photo" src="/images/ruige-kong-seattle.jpg" alt="Ruige Kong overlooking the Seattle skyline at dusk" width="1280" height="960" fetchpriority="high" />
      <div class="photo-caption"><span>Seattle, Washington</span><span>2026</span></div>
    </div>
    <div class="hero-copy reveal delay-1">
      <p class="eyebrow">Scientific machine learning, dynamics and control</p>
      <h1>I build reliable models and controllers for physical systems.</h1>
      <p class="hero-lede">I am a PhD researcher at the University of Washington. I develop and audit neural surrogate models and reinforcement learning methods for high-dimensional flow control.</p>
      <p class="hero-affiliation">Advised by <a href={links.fresca} target="_blank" rel="noreferrer">Prof. Stefania Fresca</a>, AI Institute in Dynamic Systems.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#research">Selected research <Icon name="arrow" /></a>
        <a class="button button-secondary" href={links.cv} target="_blank">Download CV <Icon name="download" /></a>
      </div>
      <SocialLinks compact />
    </div>
  </section>

  <section class="credential-band" aria-label="Selected credentials">
    <div class="shell credential-grid">
      {credentials.map((item) => (
        <div class="credential-item">
          <span>{item.label}</span>
          <strong>{item.title}</strong>
          <p>{item.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="scan-section shell" id="research" aria-labelledby="research-title">
    <header class="scan-heading">
      <div>
        <p class="eyebrow">Selected research</p>
        <h2 id="research-title">Learning dynamics for prediction and control.</h2>
      </div>
      <p>My research asks when a learned model preserves enough of the underlying dynamics to support inference, optimization, and closed-loop control.</p>
    </header>

    <article class="research-feature">
      <div class="research-feature-copy">
        <div class="record-meta"><span>Current work</span><span>Manuscript in preparation</span></div>
        <h3>Audited surrogate gradients for reliable model-based flow control</h3>
        <p>Accurate state prediction does not imply a faithful control Jacobian. I compare automatic-differentiation gradients from neural flow surrogates with finite-difference sensitivities from direct numerical simulation, then validate the resulting feedback laws in the original solver.</p>
        <ul class="method-list" aria-label="Methods">
          <li>Neural operators</li>
          <li>Model-based control</li>
          <li>Gradient auditing</li>
          <li>Direct numerical simulation</li>
        </ul>
        <a class="text-link" href="/research/#audited-surrogates">Technical details <Icon name="arrow" size={17} /></a>
      </div>
      <a class="research-figure-link" href="/research/#audited-surrogates" aria-label="Read technical details about audited surrogate gradients">
        <figure class="scan-figure">
          <img src="/images/cylinder-mechanism.png" alt="Prediction error, gradient fidelity, and physical controller response for a rotating cylinder wake" width="1900" height="698" loading="lazy" />
          <figcaption>Prediction error, local gradient fidelity, and closed-loop physical validation.</figcaption>
        </figure>
      </a>
    </article>

    <div class="research-secondary-grid">
      <article>
        <p class="record-kicker">Scientific machine learning</p>
        <h3>State inference in neural PDE surrogates</h3>
        <p>Nonlocal reconstruction of latent physical variables from partial and spatially coarsened observations.</p>
        <a class="text-link" href="/research/#scientific-ml">Research details <Icon name="arrow" size={16} /></a>
      </article>
      <article>
        <p class="record-kicker">Environmental prediction</p>
        <h3>Interpretable wildfire segmentation</h3>
        <p>Comparison of CNN and transformer architectures under class imbalance, with global and spatial feature attribution.</p>
        <a class="text-link" href="/research/#wildfire">Research details <Icon name="arrow" size={16} /></a>
      </article>
      <article>
        <p class="record-kicker">Additional research</p>
        <h3>Machine learning for satellite dynamics</h3>
        <p>Contributions to the FISICA project. Further technical details are limited due to confidentiality.</p>
      </article>
    </div>
  </section>

  <section class="scan-section section-tint" id="publications" aria-labelledby="publications-title">
    <div class="shell">
      <header class="scan-heading compact">
        <div>
          <p class="eyebrow">Publications</p>
          <h2 id="publications-title">Papers and current manuscripts.</h2>
        </div>
        <a class="button button-secondary button-small" href={links.scholar} target="_blank" rel="noreferrer">Google Scholar <Icon name="external" size={15} /></a>
      </header>

      <div class="scan-publication-list">
        <article class="scan-publication">
          <div class="scan-publication-year"><strong>2026</strong><span>In preparation</span></div>
          <div>
            <p class="record-kicker">Manuscript</p>
            <h3>Audited Surrogate Gradients for Reliable Model-Based Flow Control</h3>
            <p class="authors"><strong>Ruige Kong</strong>, Stefania Fresca</p>
            <p>Audits surrogate action gradients against finite-difference DNS sensitivities, then tests distilled and optimized feedback laws in the original solver.</p>
          </div>
        </article>

        <article class="scan-publication">
          <div class="scan-publication-year"><strong>2025</strong><span>Journal article</span></div>
          <div>
            <p class="record-kicker">JGR: Machine Learning and Computation, 2(2)</p>
            <h3><a href={links.wildfire} target="_blank" rel="noreferrer">Comparative and Interpretative Analysis of CNN and Transformer Models in Predicting Wildfire Spread Using Remote Sensing Data</a></h3>
            <p class="authors">Yihang Zhou, <strong>Ruige Kong</strong>, Zhengsen Xu, Linlin Xu, Sibo Cheng</p>
            <p>Compares four architectures for next day wildfire segmentation. SHAP, Grad-CAM, and Integrated Gradients characterize architecture-dependent feature attribution.</p>
            <div class="pub-links">
              <a href={links.wildfire} target="_blank" rel="noreferrer">Paper <Icon name="external" size={14} /></a>
              <a href={links.wildfireArxiv} target="_blank" rel="noreferrer">arXiv <Icon name="external" size={14} /></a>
              <a href={links.wildfireCode} target="_blank" rel="noreferrer">Code and data <Icon name="external" size={14} /></a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="scan-section shell" id="experience" aria-labelledby="experience-title">
    <header class="scan-heading">
      <div>
        <p class="eyebrow">Research and industry</p>
        <h2 id="experience-title">Selected experience.</h2>
      </div>
      <p>Academic research is the center of my work, supported by research internships across quantitative finance and computational biology.</p>
    </header>

    <div class="scan-timeline">
      {experiences.map((item) => (
        <article class="scan-timeline-item">
          <div class="scan-date">{item.dates}</div>
          <div class="scan-role">
            <h3>{item.role}</h3>
            <p>{item.org}</p>
          </div>
          <p class="scan-description">{item.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="scan-section background-section" id="background" aria-labelledby="background-title">
    <div class="shell">
      <header class="scan-heading compact">
        <div>
          <p class="eyebrow">Background</p>
          <h2 id="background-title">Education and selected recognition.</h2>
        </div>
      </header>

      <div class="background-grid">
        <div class="background-column">
          <h3 class="column-title">Education</h3>
          <article class="education-record">
            <span>2025 to 2030</span>
            <h4>PhD, Mechanical Engineering</h4>
            <p><a href={links.uwMe} target="_blank" rel="noreferrer">University of Washington</a>, AI Institute in Dynamic Systems</p>
            <small>Scientific machine learning, fluid mechanics, reinforcement learning, and optimal control.</small>
          </article>
          <article class="education-record">
            <span>2021 to 2025</span>
            <h4>MEng and BA, Information and Computer Engineering</h4>
            <p><a href={links.cambridge} target="_blank" rel="noreferrer">University of Cambridge</a></p>
            <small>Machine learning, computational science, inference, control, and signal processing.</small>
          </article>
        </div>

        <div class="background-column">
          <h3 class="column-title">Selected recognition</h3>
          <div class="recognition-list">
            {awards.map((award) => (
              <div>
                <span>{award.year}</span>
                <p><strong>{award.result}</strong><br />{award.name}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="profile-summary">
        <img src="/images/ruige-kong-sunset.jpg" alt="Ruige Kong by Puget Sound at sunset" width="1100" height="1467" loading="lazy" />
        <div>
          <p class="eyebrow">Beyond the work</p>
          <h3>I work across analysis, implementation, and physical validation.</h3>
          <p>I completed my undergraduate and master's training at Cambridge before joining the University of Washington. Outside research, I play badminton, hike, and explore the Pacific Northwest.</p>
          <dl class="profile-facts">
            <div><dt>Languages</dt><dd>English and Mandarin</dd></div>
            <div><dt>Methods</dt><dd>PyTorch, neural operators, reinforcement learning, numerical PDEs, reduced-order modeling</dd></div>
            <div><dt>Location</dt><dd>Seattle, Washington</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
