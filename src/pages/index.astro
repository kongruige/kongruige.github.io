---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ResearchCard from '../components/ResearchCard.astro';
import { interests, links } from '../data/site';
---

<BaseLayout title="Ruige Kong" description="PhD researcher at the University of Washington working on reliable scientific machine learning, dynamical systems, fluid mechanics, and control.">
  <section class="hero shell">
    <div class="hero-photo-wrap reveal">
      <img class="hero-photo" src="/images/ruige-kong-seattle.jpg" alt="Ruige Kong overlooking the Seattle skyline at dusk" width="1280" height="960" fetchpriority="high" />
      <div class="photo-caption"><span>Seattle, WA</span><span>2026</span></div>
    </div>
    <div class="hero-copy reveal delay-1">
      <p class="eyebrow">Scientific machine learning, dynamics and control</p>
      <h1>I build reliable models and controllers for physical systems.</h1>
      <p class="hero-lede">I am a PhD researcher at the University of Washington. I develop and audit neural surrogate models and reinforcement learning methods for high-dimensional flow control.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/research/">Explore my research <Icon name="arrow" /></a>
        <a class="button button-secondary" href={links.cv} target="_blank">Download CV <Icon name="download" /></a>
      </div>
      <SocialLinks compact />
    </div>
  </section>

  <section class="affiliation-strip">
    <div class="shell affiliation-inner">
      <p>PhD student in Mechanical Engineering <span>,</span> University of Washington <span>,</span> Expected 2030</p>
      <p>Advised by <a href={links.fresca} target="_blank" rel="noreferrer">Prof. Stefania Fresca</a></p>
    </div>
  </section>

  <section class="section shell" aria-labelledby="current-research-title">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">Current research</p>
        <h2 id="current-research-title">Auditing learned dynamics for reliable flow control.</h2>
      </div>
      <p>I compare surrogate action gradients with finite-difference sensitivities from a physical solver. Validated gradients are then used to extract and refine feedback controllers.</p>
    </div>

    <a class="feature-visual" href="/research/#audited-surrogates" aria-label="Learn about audited surrogate gradients for flow control">
      <img src="/images/cylinder-mechanism.png" alt="Three plots comparing model error, local gradient accuracy, and physical controller performance for a rotating cylinder wake" width="1900" height="698" loading="lazy" />
      <span class="visual-label">Prediction error, gradient fidelity, and closed-loop validation</span>
      <span class="visual-arrow"><Icon name="arrow" size={22} /></span>
    </a>
  </section>

  <section class="section section-tint">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Research themes</p>
        <h2>Physics, learning, and control.</h2>
      </div>
      <div class="research-grid">
        <ResearchCard number="01" title="Reliable surrogate control" copy="I audit local action sensitivities before using neural surrogates for controller extraction and optimization." tags={['Model-based control', 'Neural operators', 'Gradient audit']} href="/research/#audited-surrogates" />
        <ResearchCard number="02" title="Scientific machine learning" copy="I study state inference and representation learning in neural PDE surrogates trained from partial or coarsened fields." tags={['PDE surrogates', 'State inference', 'Model reduction']} href="/research/#scientific-ml" />
        <ResearchCard number="03" title="Wildfire prediction" copy="I compare CNN and transformer architectures for next day fire segmentation and analyze their feature attributions." tags={['Remote sensing', 'Explainability', 'Segmentation']} href="/research/#wildfire" />
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="publication-title">
    <div class="section-heading split-heading compact-heading">
      <div>
        <p class="eyebrow">Selected publication</p>
        <h2 id="publication-title">Deep learning for next day wildfire prediction.</h2>
      </div>
      <a class="text-link" href="/publications/">All publications <Icon name="arrow" size={17} /></a>
    </div>
    <article class="publication-feature">
      <div class="pub-year">2025</div>
      <div>
        <p class="publication-venue">Journal of Geophysical Research: Machine Learning and Computation</p>
        <h3><a href={links.wildfire} target="_blank" rel="noreferrer">Comparative and Interpretative Analysis of CNN and Transformer Models in Predicting Wildfire Spread Using Remote Sensing Data</a></h3>
        <p class="authors">Yihang Zhou, <strong>Ruige Kong</strong>, Zhengsen Xu, Linlin Xu, Sibo Cheng</p>
        <p class="pub-summary">We evaluated four architectures under severe class imbalance using AUC-PR, computational cost, and data efficiency. SHAP, Grad-CAM, and Integrated Gradients revealed architecture-dependent feature use.</p>
        <div class="pub-links">
          <a href={links.wildfire} target="_blank" rel="noreferrer">Paper <Icon name="external" size={15} /></a>
          <a href={links.wildfireArxiv} target="_blank" rel="noreferrer">arXiv <Icon name="external" size={15} /></a>
          <a href={links.wildfireCode} target="_blank" rel="noreferrer">Code and data <Icon name="external" size={15} /></a>
        </div>
      </div>
    </article>
  </section>

  <section class="section signal-section">
    <div class="shell signal-grid">
      <div>
        <p class="eyebrow light">Background</p>
        <h2>Research across engineering and science.</h2>
      </div>
      <div class="signal-copy">
        <p>My work spans model-based flow control, PDE state inference, remote sensing, biological sequence modeling, and financial language models. Across these settings, I focus on controlled experiments, strong baselines, and interpretable diagnostics.</p>
        <a class="text-link light-link" href="/experience/">View experience <Icon name="arrow" size={17} /></a>
      </div>
      <ul class="interest-list">
        {interests.map((interest, index) => <li><span>0{index + 1}</span>{interest}</li>)}
      </ul>
    </div>
  </section>

  <section class="section shell closing-cta">
    <p class="eyebrow">Collaborate</p>
    <h2>I welcome research conversations about machine learning, control, and physical systems.</h2>
    <a class="button button-primary" href={links.email}>Get in touch <Icon name="mail" /></a>
  </section>
</BaseLayout>
