---
import Icon from './Icon.astro';
interface Props {
  number: string;
  title: string;
  copy: string;
  tags: string[];
  href?: string;
  linkText?: string;
  status?: string;
}
const { number, title, copy, tags, href, linkText = 'Read more', status } = Astro.props;
---

<article class="research-card">
  <div class="card-meta">
    <span class="card-number">{number}</span>
    {status && <span class="status-pill">{status}</span>}
  </div>
  <h3>{title}</h3>
  <p>{copy}</p>
  <ul class="tag-list" aria-label="Research topics">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
  {href && <a class="text-link" href={href}>{linkText} <Icon name="arrow" size={17} /></a>}
</article>
